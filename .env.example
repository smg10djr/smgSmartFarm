# copy to .env (never commit .env)
POSTGRES_USER=smartfarm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smartfarm_development
DATABASE_HOST=localhost
# 이미 PC에 PostgreSQL이 설치되어 5432가 사용 중이면 5433 등으로 바꿉니다
POSTGRES_PORT=5432
# 브로커 포트 (바꾸면 ESP32의 secrets.h MQTT_PORT도 같이 바꿉니다)
MQTT_PORT=1883
# 브로커 인증을 켰을 때만 사용합니다 (docs/testing.md의 "Mosquitto 인증 켜기").
# Rails 구독자(bin/mqtt_subscriber)는 사용자 rails, bin/fake_sensor는 사용자를 deviceId와 같게 지정합니다.
# MQTT_USERNAME=rails
# MQTT_PASSWORD=change-me
