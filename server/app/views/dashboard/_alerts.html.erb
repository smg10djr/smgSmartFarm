<ul id="alerts">
  <% if alerts.empty? %>
    <li>알림이 없습니다.</li>
  <% end %>
  <% alerts.each do |alert| %>
    <li class="<%= alert.open? ? "alert-open" : "alert-resolved" %>">
      <strong><%= alert.device.device_id %></strong>
      <%= alert.message %>
      · <%= l(alert.triggered_at.in_time_zone, format: :short) %>
      <%= alert.open? ? "(진행 중)" : "(해제됨)" %>
    </li>
  <% end %>
</ul>
