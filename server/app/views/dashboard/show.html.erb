<%= turbo_stream_from "dashboard" %>

<main class="dashboard">
  <h1>스마트팜 대시보드</h1>

  <% if notice %><p class="notice"><%= notice %></p><% end %>
  <% if alert %><p class="alert-open"><%= alert %></p><% end %>

  <% if @devices.empty? %>
    <p>아직 수신된 장치가 없습니다. <code>bin/fake_sensor</code>로 가짜 메시지를 보내 보세요.</p>
  <% end %>

  <% @devices.each do |device| %>
    <%= render "dashboard/device", device: device %>
  <% end %>

  <% if @devices.any? %>
    <h2>pH·EC 수동 입력</h2>
    <%= form_with model: ManualMeasurement.new, url: manual_measurements_path, class: "manual-form" do |f| %>
      <%= f.collection_select :device_id, @devices, :id, :device_id %>
      <%= f.number_field :ph, step: 0.01, min: 0, max: 14, placeholder: "pH (예: 6.0)" %>
      <%= f.number_field :ec_ms_cm, step: 0.01, min: 0, max: 10, placeholder: "EC mS/cm (예: 1.2)" %>
      <%= f.text_field :note, placeholder: "메모 (선택)" %>
      <%= f.submit "기록" %>
    <% end %>
  <% end %>

  <h2>알림</h2>
  <%= render "dashboard/alerts", alerts: @alerts %>
</main>
